or(`  台词：${rawLines.length} 帧 → ${out.length} 条 → ${subtitleFile}`);+  }++  // ── 5. 拼图（只放保留下来的画面）+  const sheets = [];+  let batch = 0;+  for (let b = 0; b < kept.length; b += per) {+    batch += 1;+    const chunk = kept.slice(b, b + per);+    const cells = chunk.map((c, k) => ({+      index: b + k + 1,+      frame: c.frame.data, width: c.frame.width, height: c.frame.height,+    }));+    const pixels = composeSheet({ grid, cells, gutter: args.gutter });+    const name = `sheet-${String(batch).padStart(3, '0')}.png`;+    const file = path.join(outDir, name);+    await fsp.writeFile(file, encodePng(pixels.data, pixels.width, pixels.height));+    sheets.push({ file, cells: chunk.map((c, k) => ({ n: b + k + 1, t: c.t })) });+    console.error(`  ${name}  ${chunk.length} 格  ${chunk[0].t.toFixed(0)}s-${chunk[chunk.length - 1].t.toFixed(0)}s`);+  }++  await fsp.rm(frameDir, { recursive: true, force: true }).catch(() => {});++  const indexPath = path.join(outDir, 'index.json');+  await fsp.writeFile(indexPath, JSON.stringify({+    input: args.input, start, end: duration, step, perSheet: per, cellW, cellH,+    totalFrames: times.length, keptFrames: kept.length, droppedFrames: dropped,+    sheets, subtitles: subtitleFile,+  }, null, 2));++  console.log(JSON.stringify({+    ok: true, outDir, indexPath, sheets: sheets.length,+    totalFrames: times.length, keptFrames: kept.length, droppedFrames: dropped,+    subtitles: subtitleFile, first: sheets[0]?.file, last: sheets[sheets.length - 1]?.file,+  }));+}++main().catch((e) => {+  console.error('失败：' + (e?.message ?? e));+  process.exit(1);+});diff --git a/bin/where.mjs b/bin/where.mjsnew file mode 100644index 0000000..95ad331--- /dev/null+++ b/bin/where.mjs@@ -0,0 +1,115 @@+#!/usr/bin/env node+/**+ * where.mjs —— 台词 ↔ 画面 的对照：给一句话/一个秒数，指出它落在哪张分镜的哪一格。+ *+ * 为什么需要它（2026-10-31）：+ *   scan-video 产出两样东西 —— 分镜图（画面）和 subtitles.txt（台词，带 [秒]）。+ *   但「这句台词是谁说的、画面里那个人长什么样」这两个信息分开放，光看台词会认错人+ *   （实际发生过：把金王认成罗曼）。这个工具把两边对上，让人能直接跳到那一格去看脸。+ *+ * 用法：+ *   node bin/where.mjs <scan输出目录> --at 233            # 第 233 秒那格在哪+ *   node bin/where.mjs <scan输出目录> --grep "米格尔"      # 含这句台词的格子+ *   node bin/where.mjs <scan输出目录> --range 200 260      # 这一段的所有台词+格号+ */+import fs from 'node:fs';+import path from 'node:path';++function parseArgs(argv) {+  const out = { at: null, grep: null, range: null };+  const rest = [];+  for (let i = 0; i < argv.length; i++) {+    const a = argv[i];+    if (a === '--at') out.at = Number(argv[++i]);+    else if (a === '--grep') out.grep = argv[++i];+    else if (a === '--range') { out.range = [Number(argv[++i]), Number(argv[++i])]; }+    else rest.push(a);+  }+  out.dir = rest[0];+  return out;+}++function load(dir) {+  const idx = JSON.parse(fs.readFileSync(path.join(dir, 'index.json'), 'utf8'));+  const cells = [];+  for (const sh of idx.sheets || []) {+    for (const c of sh.cells || []) cells.push({ ...c, sheet: path.basename(sh.file), file: sh.file });+  }+  cells.sort((a, b) => a.t - b.t);++  let subs = [];+  const sp = path.join(dir, 'subtitles.txt');+  if (fs.existsSync(sp)) {+    for (const line of fs.readFileSync(sp, 'utf8').split('\n')) {+      const m = line.match(/^\[(\d+)s\]\s*(.+)$/);+      if (m) subs.push({ t: Number(m[1]), text: m[2].trim() });+    }+  }+  return { idx, cells, subs };+}++/** 找离 t 最近的格（不超过 3 秒） */+function cellAt(cells, t) {+  let best = null;+  let bestD = Infinity;+  for (const c of cells) {+    const d = Math.abs(c.t - t);+    if (d < bestD) { bestD = d; best = c; }+  }+  return bestD <= 3 ? best : null;+}++function main() {+  const args = parseArgs(process.argv.slice(2));+  if (!args.dir) {+    console.error('用法：node bin/where.mjs <scan输出目录> --at 秒 | --grep 关键词 | --range 起 止');+    process.exit(2);+  }+  const { idx, cells, subs } = load(args.dir);+  console.log(`目录 ${args.dir}`);+  console.log(`共 ${idx.sheets.length} 张分镜 / ${cells.length} 格 / ${subs.length} 条台词（${idx.start}s-${idx.end}s）`);+  console.log('');++  if (args.at != null) {+    const c =