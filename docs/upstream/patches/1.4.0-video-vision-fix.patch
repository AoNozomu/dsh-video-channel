{+    const fps = 1 / step;+    const tpl = path.join(frameDir, 'f%05d.png');+    const res = await run(ffmpegPath, [+      '-hide_banner', '-nostdin', '-v', 'error',+      '-ss', String(start), '-t', String(Math.max(0.5, duration - start)),+      '-i', args.input,+      '-vf', `fps=${fps},scale=${args.ocrWidth}:${ocrH}`,+      '-q:v', '2', '-y', tpl,+    ], { timeoutMs: 1_800_000 });+    if (res.code !== 0) console.error(`  ⚠ 抽帧失败：${String(res.stderr || '').slice(-200)}`);+    frameFiles = (await fsp.readdir(frameDir)).filter((n) => n.endsWith('.png')).sort();+    console.error(`  整帧 ${frameFiles.length} 张（${args.ocrWidth}px 宽，给 OCR）`);+  }++  // ── 2. OCR（RapidOCR，只留底部字幕区）+  const byFrame = new Map();+  if (args.subtitle && frameFiles.length) {+    const script = path.join(HERE, 'ocr_frames.py');+    if (!fs.existsSync(script)) {+      console.error(`  ⚠ 找不到 ${script}`);+    } else if (!fs.existsSync(args.ocrPython)) {+      console.error(`  ⚠ 找不到 OCR 的 python：${args.ocrPython}（用 --ocr-python 指定）`);+    } else {+      console.error('  正在 OCR（RapidOCR）…');+      const r = await runPython(args.ocrPython, script, [frameDir, '--bottom', String(args.bottom), '--quiet']);+      if (!r.ok || !r.parsed) {+        console.error(`  ⚠ OCR 失败：${r.stderr || r.error || `exit ${r.code}`}`);+      } else {+        try {+          const raw = JSON.parse(await fsp.readFile(r.parsed.out, 'utf8'));+          for (const fr of raw.frames || []) byFrame.set(fr.file, fr.lines || []);+          console.error(`  OCR 完成：${r.parsed.withText}/${r.parsed.frames} 帧有字，${r.parsed.seconds}s`);+        } catch (e) {+          console.error(`  ⚠ 读 OCR 结果失败：${e.message}`);+        }+      }+    }+  }++  // ── 3. 逐帧：抽小图（拼图用）+ 收集台词+  const kept = [];+  let lastKept = null;+  let dropped = 0;+  const rawLines = [];++  for (let i = 0; i < times.length; i++) {+    const t = times[i];+    const frame = await extractFrame({ input: args.input, ffmpegPath, t, width: cellW, height: cellH });+    if (!frame.dat