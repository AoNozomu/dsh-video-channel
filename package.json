{
  "name": "dsh-video-channel",
  "version": "1.4.0",
  "description": "Long-form video understanding for DeepSeek Harness: scan a whole episode into per-second OCR subtitle lines plus timecoded storyboard sheets. A fork of dsh-video-vision.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "video",
    "storyboard",
    "contact-sheet",
    "ffmpeg",
    "multimodal",
    "vision",
    "deepseek-v4.1-flash"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./scan": "./src/scan.js",
    "./layout": "./src/layout.js",
    "./sheet": "./src/sheet.js",
    "./media": "./src/media.js",
    "./pipeline": "./src/pipeline.js",
    "./manifest": "./src/manifest.js"
  },
  "files": [
    "src",
    "bin",
    "test",
    "docs",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "screenshots.json",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dsh-video-channel-install": "bin/install.mjs",
    "dsh-video-channel-selfcheck": "bin/selfcheck.mjs"
  },
  "scripts": {
    "test": "node --test test/",
    "selfcheck": "node bin/selfcheck.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "homepage": "https://github.com/Destinhue/dsh-video-vision#readme",
  "bugs": {
    "url": "https://github.com/Destinhue/dsh-video-vision/issues"
  },
  "private": false
}
