From 62ce34c80f98151e4991870cc94875e98d1604df Mon Sep 17 00:00:00 2001From: Destinhue <l15005199796@gmail.com>Date: Sun, 1 Nov 2026 15:32:43 +0800Subject: [PATCH] 1.4.0: fix video_read dropping every subtitle, prefer RapidOCRTwo bugs stacked in video_read, either one enough to make an episode readas "this video has no text":1. Sampling never went dense. The dense branch was gated on if (!end),   and index.js passes end: args.end ?? 0, so it was nearly unreachable.   A 300s window decoded 63 keyframes (one per 4.8s) instead of 251 frames   (one per 1.2s); a subtitle that stays 1-3s falls between keyframes.   Density now follows the window length, not whether end was passed.2. The "is there text here" test was tuned for slides: one line of >=12 CJK   characters, or 24 across the frame. A subtitle is 4-12 characters, so 7   real lines out of a 15-frame sample were all rejected -- while the only   line that passed was a 13-character title card.Fixed with a second rule rather than a looser one: readableScreen keeps itsthresholds, and burned-in subtitles are admitted by position (subtitleBand:1-3 lines hugging the bottom quarter carrying most of the frame's text).Length can never separate a subtitle from a scribble; position can.The counter-example that broke the first attempt (10 CJK characters of OCRnoise) is still rejected, and the suite is green (223 pass).Measured on the same 15 frames: 2 readable -> 14. On runRead(150-210s):0 screens -> 9 screens, with timecoded lines.Also: prefer RapidOCR over Windows.Media.Ocr (same 8 frames -- "bilibili"had 4 different wrong readings under Windows OCR, 0 under RapidOCR; WindowsOCR also spaces out every CJK character, which breaks substring matching).Windows stays as the fallback. src/ocr-python.js finds that python insteadof hardcoding E:\ocr-env (one machine's layout, in a public package).New: bin/scan-video.mjs, bin/where.mjs, bin/ocr_frames.py,bin/ocr-batch-rapid.py, bin/diag_subtitle.py (the y-position dump that foundbug 2). vendor/ and *.bak are now gitignored -- 75MB of binaries must notride along with the code.--- .gitignore             |    9 + CHANGELOG.md           |   58 ++ bin/diag_subtitle.py   |  144 ++++ bin/ocr-batch-rapid.py |   96 +++ bin/ocr_frames.py      |  122 ++++ bin/scan-video.mjs     |  331 +++++++++ bin/where.mjs          |  115 +++ package.json           |    2 +- src/layout.js          | 1523 ++++++++++++++++++++-------------------- src/ocr-python.js      |   94 +++ src/ocr.js             |  126 +++- src/read.js            |   87 ++- src/tools.js           |    2 +- 13 files changed, 1914 insertions(+), 795 deletions(-) create mode 100644 bin/diag_subtitle.py create mode 100644 bin/ocr-batch-rapid.py create mode 100644 bin/ocr_frames.py create mode 100644 bin/scan-video.mjs create mode 100644 bin/where.mjs create mode 100644 src/ocr-python.jsdiff --git a/.gitignore b/.gitignoreindex adeb288..dc3ecf0 100644--- a/.gitignore+++ b/.gitignore@@ -10,3 +10,12 @@ dist/ *.zip .DS_Store Thumbs.db++# 2026-11-01 加：二进制的 ffmpeg/ffprobe 与 OCR 环境 —— 75MB+，绝不能进仓库+# （装法见 bin/install.mjs / 文档；仓库只放代码）+vendor/+ocr-env/++# 手工改动前的临时备份（.bak-xxxx 这种），不是源码+*.bak+*.bak-*diff --git a/CHANGELOG.md b/CHANGELOG.mdindex ee4122d..0640419 100644--- a/CHANGELOG.md+++ b/CHANGELOG.md@@ -1,5 +1,63 @@ # Changelog +## 1.4.0++### Fixed++- **`video_read` dropped every subtitle on a long video.** Two bugs stacked, and+  either one alone was enough to make a TV episode read as "this video has no+  text":++  1. **Sampling never went dense.** The dense branch was gated on `if (!end)`,+     and `src/index.js` passes `end: args.end ?? 0` — so the branch was nearly+     unreachable. A 300 s window decoded **63 keyframes (one per 4.8 s)** instead+     of **251 frames (one per 1.2 s)**, and a subtitle that stays 1–3 s falls+     between keyframes. The decision now looks at the *window length*+     (`end - start`), so passing `end` no longer changes the sampling density.+  2. **The "is there text here" test was tuned for slides.** It required one line+     of ≥ 12 CJK characters (or 24 across the frame). A subtitle is 4–12+     characters, so **7 real lines in a 15-frame sample were all rejected** —+     `这三十秒回不来了` (8), `抱歉 老大` (4), `哪个是我们的` (6) — while the only+     line that passed was a 13-character title card.++  Fixed with a **second rule instead of a looser one**: `readableScreen` keeps+  its original thresholds, and burned-in subtitles are admitted by *position*+  (`subtitleBand` — 1–3 lines hugging the bottom quarter, carrying most of what+  the frame says). Length can never separate a subtitle from a scribble; position+  can, and the counter-example that broke the first attempt+  (`亿天小釒一 0 立去千凸到`, 10 CJK characters of OCR noise) still gets rejected.++  Measured on the same 15 frames: **2 readable → 14 readable**; on+  `runRead(150–210 s)` of the same episode: **0 screens → 9 screens**, with+  timecoded lines.++### Added++- **RapidOCR backend, preferred over Windows.Media.Ocr.** Same 8 frames, same+  place, `--bottom` aside:++  | text | Windows OCR | RapidOCR |+  | --- | --- | --- |+  | `4K修复播放室` | `4K 修 复 播 放 室 LiliLi\i` | `4K修复播放室` |+  | `bilibili` | `LiliLili` / `VliLi\i` / `LiIiLiIi` / `LiliLiIi` (4 variants in 8 frames) | `bilibili`, all 8 |+  | `迈克·庞德史密斯` | `迈 克 到 庞 德 史 密 斯` | `迈克·庞德史密斯` |++  Windows OCR also puts a space between every CJK character, which breaks+  substring matching downstream. The Windows engine is kept as the fallback so+  the tool still works without python.++- `src/ocr-python.js`: RapidOCR is found, not assumed. `$DSH_OCR_PYTHON` wins,+  then `<plugin>/vendor/ocr-env`, a sibling `ocr-env`, `%LOCALAPPDATA%`,+  `%USERPROFILE%`, then `<drive>:\ocr-env` for the original layout. Before this,+  two files hardcoded `E:\ocr-env\Scripts\python.exe` — one machine's layout in a+  public package.++- `bin/scan-video.mjs` (line-by-line scan: picture deduped by change, dialogue+  OCR'd every second, `subtitles.txt` with `[mm:ss]`), `bin/where.mjs`,+  `bin/ocr_frames.py`, `bin/ocr-batch-rapid.py`, and `bin/diag_subtitle.py` — a+  diagnostic that dumps every OCR line's y-position, which is how the second bug+  above was found.+ ## 1.3.2  ### Addeddiff --git a/bin/diag_subtitle.py b/bin/diag_subtitle.pynew file mode 100644index 0000000..ccd6467--- /dev/null+++ b/bin/diag_subtitle.py@@ -0,0 +1,144 @@+#!/usr/bin/env python+# -*- coding: utf-8 -*-+"""+diag_subtitle.py —— 诊断「为什么这条视频抽不到字幕」。++做一件事：抽几帧，把 OCR 认到的**每一行文字**的 y 位置（占图高的比例）全打出来，+按 y 排序。这样一眼能看出：+  · 字幕到底在哪一带（0.92？0.75？0.60？）+  · 现在的 --bottom 0.80 是不是把它切掉了+  · 前 10 分钟是不是真的没有字幕（有文字但都在上方 = OP/标题/招牌）++用法:+  E:\\ocr-env\\Scripts\\python.exe diag_subtitle.py <视频文件> [--start 0] [--end 600] [--every 20]++  --every 20  每 20 秒抽一帧（10 分钟默认抽 30 帧，够看分布）+"""+import argparse+import json+import os+import subprocess+import sys+import tempfile+++def main():+    ap = argparse.ArgumentParser()+    ap.add_argument("video")+    ap.add_argument("--start", type=float, default=0)+    ap.add_argument("--end", type=float, default=600)+    ap.add_argument("--every", type=float, default=20, help="每隔几秒抽一帧")+    ap.add_argument("--width", type=int, default=960)+    ap.add_argument("--out", default="")+    args = ap.parse_args()++    if not os.path.exists(args.video):+        print("视频不存在: %s" % args.video, file=sys.stderr)+        sys.exit(2)++    tmp = tempfile.mkdtemp(prefix="diagsub-")+    print("抽帧到: %s" % tmp, file=sys.stderr)++    # 抽帧：每 N 秒一张整帧+    cmd = [+        "ffmpeg", "-hide_banner", "-loglevel", "error",+        "-ss", str(args.start), "-to", str(args.end),+        "-i", args.video,+        "-vf", "fps=1/%g,scale=%d:-2" % (args.every, args.width),+        os.path.join(tmp, "f%04d.png"),+    ]+    r = subprocess.run(cmd, capture_output=True, text=True)+    if r.returncode != 0:+        print("ffmpeg 失败: %s" % (r.stderr or "")[:400], file=sys.stderr)+        sys.exit(2)++    files = sorted(f for f in os.listdir(tmp) if f.endswith(".png"))+    if not files:+        print("没抽到帧（--start/--end 超出时长？）", file=sys.stderr)+        sys.exit(2)+    print("抽到 %d 帧（每 %g 秒一帧）" % (len(files), args.every), file=sys.stderr)++    from rapidocr_onnxruntime import RapidOCR+    from PIL import Image+    engine = RapidOCR()++    rows = []          # (秒, 文本, y比例, 置信度)+    H = None+    for i, name in enumerate(files):+        path = os.path.join(tmp, name)+        if H is None:+            with Image.open(path) as im:+                H = im.height+        sec = args.start + i * args.every+        try:+            result, _ = engine(path)+        except Exception as e:+            print("  OCR 异常 %s: %s" % (name, str(e)[:80]), file=sys.stderr)+            continue+        if not result:+            continue+        for item in result:+            box, text = item[0], item[1]+            score = float(item[2]) if len(item) > 2 and isinstance(item[2], (int, float)) else 1.0+            if score < 0.45:+                continue+            ys = [pt[1] for pt in box]+            y_top = min(ys)+            rows.append({+                "sec": round(sec, 1),+                "text": str(text).strip()[:40],+                "y": round(y_top / H, 3),+                "score": round(score, 2),+            })+        if (i + 1) % 10 == 0:+            print("  OCR %d/%d" % (i + 1, len(files)), file=sys.stderr)++    out = args.out or os.path.join(os.getcwd(), "diag_subtitle.json")+    with open(out, "w", encoding="utf-8") as f:+        json.dump({"video": args.video, "height": H, "rows": rows}, f, ensure_ascii=False, indent=1)++    # ── 报告 ─────────────────────────────────────────+    print("")+    print("图片高度 %s px，共认出 %d 行文字" % (H, len(rows)))+    if not rows:+        print("⚠️  一帧都没认出文字 —— 可能是：①这段真的没有字 ②分辨率太低 ③全屏画面")+        print("JSON: %s" % out)+        return++    buckets = {}+    for r in rows:+        b = round(r["y"] * 10) / 10     # 0.1 一档+        buckets[b] = buckets.get(b, 0) + 1+    print("")+    print("y 位置分布（占图高比例，1.0=最底边）：")+    for b in sorted(buckets):+        bar = "█" * min(40, buckets[b])+        mark = ""+        if 0.78 <= b < 0.84:+            mark = "  ← 当前 cut=0.80 在附近"+        if b < 0.78:+            mark = "  ← 会被 cut 切掉！"+        print("  y≈%.1f  %3d 行  %s%s" % (b, buckets[b], bar, mark))++    sub = [r for r in rows if r["y"] >= 0.80]+    below = [r for r in rows if r["y"] < 0.80]+    print("")+    print("当前 --bottom 0.80 会保留 %d 行，丢掉 %d 行" % (len(sub), len(below)))+    if below:+        print("被丢掉的最靠下的 8 行（这些可能就是字幕）：")+        for r in sorted(below, key=lambda x: -x["y"])[:8]:+            print("  [%6.1fs] y=%.2f  «%s»" % (r["sec"], r["y"], r["text"]))++    if sub:+        print("")+        print("保留下来、最像字幕的 8 行：")+        for r in sorted(sub, key=lambda x: x["sec"])[:8]:+            print("  [%6.1fs] y=%.2f  «%s»" % (r["sec"], r["y"], r["text"]))++    print("")+    print("JSON: %s" % out)+    print("帧目录: %s（看完可以删）" % tmp)+++if __name__ == "__main__":+    main()diff --git a/bin/ocr-batch-rapid.py b/bin/ocr-batch-rapid.pynew file mode 100644index 0000000..a1c6bac--- /dev/null+++ b/bin/ocr-batch-rapid.py@@ -0,0 +1,96 @@+#!/usr/bin/env python+# -*- coding: utf-8 -*-+"""+ocr-batch-rapid.py —— RapidOCR 版的 ocr-batch，**输出格式与 ocr-batch.ps1 完全一致**。++为什么要有这一版（2026-11-01 爸爸要求的）：+  QQ 侧没有命令行，只能用 DSH 的 video_read，而 video_read 固定走 Windows.Media.Ocr。+  实测 Windows OCR 会把「在灯管下滴答」读成「疒下谪」，而且同一帧时好时坏 ——+  拿它读番剧字幕（白字描边压画面）基本失效，实测前 10 分钟一条都抽不到。+  RapidOCR 对整帧识别准确率高得多（「阿维达」「砸锅了这单黄了」100% 对），+  B站 侧的 scan-video 一直用它，所以这边也换成它。++输出格式（与 ocr-batch.ps1 一致，让 src/ocr.js 的 parseSection 无需改动）：+  == f00001 ==+  @@ 960 540+  12 680 640 710	这句台词+  ...++用法（由 src/ocr.js 调用）：+  python ocr-batch-rapid.py -Dir <png目录> -Out <输出txt>+"""+import argparse+import os+import sys+++def main():+    ap = argparse.ArgumentParser()+    ap.add_argument("--Dir", "-Dir", dest="dir", required=True, help="PNG 目录")+    ap.add_argument("--Out", "-Out", dest="out", required=True, help="输出 txt")+    args = ap.parse_args()++    if not os.path.isdir(args.dir):+        print("目录不存在: %s" % args.dir, file=sys.stderr)+        return 2++    from rapidocr_onnxruntime import RapidOCR+    from PIL import Image++    engine = RapidOCR()+    files = sorted(f for f in os.listdir(args.dir) if f.lower().endswith(".png"))++    lines_out = []+    for name in files:+        stem = os.path.splitext(name)[0]+        path = os.path.join(args.dir, name)+        lines_out.append("== %s ==" % stem)+        try:+            with Image.open(path) as im:+                W, H = im.size+            lines_out.append("@@ %d %d" % (W, H))+        except Exception:+            lines_out.append("@@ 0 0")+            continue++        try:+            result, _ = engine(path)+        except Exception as e:+            lines_out.append("[ocr-error] %s" % str(e)[:200])+            continue++        if not result:+            continue+        for item in result:+            try:+                box, text = item[0], item[1]+                score = float(item[2]) if len(item) > 2 and isinstance(item[2], (int, float)) else 1.0+            except Exception:+                continue+            # 与 Windows 版对齐：低置信度丢掉，避免把画面噪声当文字+            if score < 0.45:+                continue+            t = str(text).strip()+            if not t:+                continue+            try:+                xs = [pt[0] for pt in box]+                ys = [pt[1] for pt in box]+            except Exception:+                continue+            x0, y0 = int(min(xs)), int(min(ys))+            x1, y1 = int(max(xs)), int(max(ys))+            if x1 <= x0 or y1 <= y0:+                x0 = y0 = x1 = y1 = 0+            lines_out.append("%d %d %d %d\t%s" % (x0, y0, x1, y1, t))++    with open(args.out, "w", encoding="utf-8") as f:+        f.write("\n".join(lines_out) + "\n")++    got = sum(1 for l in lines_out if "\t" in l)+    print("ok frames=%d lines=%d" % (len(files), got), file=sys.stderr)+    return 0+++if __name__ == "__main__":+    sys.exit(main())diff --git a/bin/ocr_frames.py b/bin/ocr_frames.pynew file mode 100644index 0000000..9e61c04--- /dev/null+++ b/bin/ocr_frames.py@@ -0,0 +1,122 @@+#!/usr/bin/env python+# -*- coding: utf-8 -*-+"""+ocr_frames.py —— 用 PaddleOCR/RapidOCR 批量识别一帧目录里的文字，只留底部的字幕。++为什么这么干（2026-10-31 爸爸要的）：+  · Windows 自带 OCR 会把「在灯管下滴」读成「疒下谪」，错字太多，而且同一帧时好时坏；+  · RapidOCR 对**整帧**识别准确率高（实测「阿维达」100% 对），但喂它**细长字幕条**会直接返回空；+  · 所以这里喂整帧，再按 y 坐标只保留底部那一条（字幕区），顺便丢掉台标/水印。++用法：+  python ocr_frames.py <图片目录> [--out out.json] [--bottom 0.72] [--min-score 0.5] [--quiet]++输出 JSON：+  { "frames": [ { "file": "f00001.png", "lines": [ {"text": "...", "y": 660, "score": 0.98} ] } ] }+"""+import argparse+import json+import os+import sys+import time+++def main():+    ap = argparse.ArgumentParser()+    ap.add_argument("dir", help="存放 PNG 帧的目录")+    ap.add_argument("--out", default="", help="输出 JSON 路径（默认 <dir>/ocr.json）")+    ap.add_argument("--bottom", type=float, default=0.80,+                    help="只保留 y > 图高*这个比例 的文字（0.85 = 下 15%%，实测字幕就在这一带）")+    ap.add_argument("--min-score", type=float, default=0.45, help="置信度下限")+    ap.add_argument("--quiet", action="store_true")+    args = ap.parse_args()++    if not os.path.isdir(args.dir):+        print("目录不存在: %s" % args.dir, file=sys.stderr)+        sys.exit(2)++    files = sorted(f for f in os.listdir(args.dir) if f.lower().endswith(".png"))+    if not files:+        print("目录里没有 png: %s" % args.dir, file=sys.stderr)+        sys.exit(2)++    # 延迟导入：让 --help 也能秒开+    from rapidocr_onnxruntime import RapidOCR+    engine = RapidOCR()++    frames = []+    t0 = time.time()+    for i, name in enumerate(files):+        path = os.path.join(args.dir, name)+        try:+            result, _ = engine(path)+        except Exception as e:+            frames.append({"file": name, "lines": [], "error": str(e)[:120]})+            continue++        lines = []+        if result:+            for item in result:+                box, text = item[0], item[1]+                score = float(item[2]) if len(item) > 2 and isinstance(item[2], (int, float)) else 1.0+                if score < args.min_score:+                    continue+                try:+                    ys = [pt[1] for pt in box]+                    xs = [pt[0] for pt in box]+                except Exception:+                    continue+                y_top = min(ys)+                y_bottom = max(ys)+                x_left = min(xs)+                height = max(y_bottom, 1)+                # 高度要用整张图来判断底部区；这里用检测框的绝对坐标 + 图片高度+                lines.append({+                    "text": str(text).strip(),+                    "y": round(float(y_top), 1),+                    "score": round(score, 3),+                    "_bottom": round(float(y_bottom), 1),+                    "_x": round(float(x_left), 1),+                })+        frames.append({"file": name, "lines": lines})++        if not args.quiet and (i + 1) % 50 == 0:+            print("  OCR %d/%d  %.0fs" % (i + 1, len(files), time.time() - t0), file=sys.stderr)++    # 第二遍：按图片实际高度裁掉非字幕区（需要知道图高，用 PIL 读一次尺寸）+    try:+        from PIL import Image+        for fr in frames:+            if not fr["lines"]:+                continue+            path = os.path.join(args.dir, fr["file"])+            try:+                with Image.open(path) as im:+                    H = im.height+            except Exception:+                continue+            cut = H * args.bottom+            fr["lines"] = [ln for ln in fr["lines"] if ln["y"] >= cut]+            for ln in fr["lines"]:+                ln.pop("_bottom", None)+                ln.pop("_x", None)+    except ImportError:+        # 没有 PIL 就不裁，把全部文字留下+        for fr in frames:+            for ln in fr["lines"]:+                ln.pop("_bottom", None)+                ln.pop("_x", None)++    out = args.out or os.path.join(args.dir, "ocr.json")+    with open(out, "w", encoding="utf-8") as f:+        json.dump({"frames": frames}, f, ensure_ascii=False, indent=1)++    kept = sum(1 for fr in frames if fr["lines"])+    print(json.dumps({+        "ok": True, "out": out, "frames": len(frames),+        "withText": kept, "seconds": round(time.time() - t0, 1),+    }, ensure_ascii=False))+++if __name__ == "__main__":+    main()diff --git a/bin/scan-video.mjs b/bin/scan-video.mjsnew file mode 100644index 0000000..5c9baaf--- /dev/null+++ b/bin/scan-video.mjs@@ -0,0 +1,331 @@+#!/usr/bin/env node+/**+ * scan-video.mjs —— 逐秒扫描视频：画面按「变化」保留，台词按「全部」读出。+ *+ * 爸爸定的口径（2026-10-31）：+ *   画面可以省，台词一句都不能少 —— 所以两者分开处理：+ *     · 画面：相邻帧差异小的丢弃（同一张脸不会刷 N 遍），拼成带格号的分镜图；+ *     · 台词：抽出来的整帧交给 RapidOCR（E:\ocr-env）逐帧识别，只取底部字幕区，+ *             按时间码输出，相邻重复合并。+ *+ * 为什么用 RapidOCR 而不是 Windows 自带 OCR（2026-10-31 实测）：+ *   Windows 版会把「在灯管下滴答」读成「疒下谪」，而且同一帧时好时坏；+ *   RapidOCR 对**整帧**识别准确率高（「阿维达」「砸锅了这单黄了」100% 对），+ *   但对**细长字幕条**会直接返回空 —— 所以喂整帧、再按 y 坐标裁出底部字幕。+ *+ * 用法：+ *   node bin/scan-video.mjs <视频文件> [--start 0] [--end 780] [--step 1]+ *                            [--per-sheet 16] [--cols 4] [--width 480]+ *                            [--ocr-python E:\ocr-env\Scripts\python.exe]+ *                            [--no-subtitle] [--out <目录>]+ *+ * 输出：<out>/sheet-001.png ...（画面）+ <out>/subtitles.txt（带 [秒] 的台词）+ <out>/index.json+ */+import fs from 'node:fs';+import fsp from 'node:fs/promises';+import path from 'node:path';+import os from 'node:os';+import { spawn } from 'node:child_process';+import { fileURLToPath } from 'node:url';+import { extractFrame } from '../src/frames.js';+import { composeSheet } from '../src/sheet.js';+import { encodePng } from '../src/png.js';+import { findFfmpeg, findFfprobe, run, parseFfmpegBanner } from '../src/media.js';+import { findRapidPython } from '../src/ocr-python.js';++const HOME = process.env.DSH_HOME || path.join(os.homedir(), '.dsh');+const HERE = path.dirname(fileURLToPath(import.meta.url));+// 2026-11-01：原来是写死的 E:\ocr-env\Scripts\python.exe（一台机器专用，仓库是公开的）。+// 改成和 src/ocr.js 共用同一套探测（ 优先，然后看几个常见位置）。+const DEFAULT_OCR_PY = findRapidPython() || '';++function parseArgs(argv) {+  const out = {+    start: 0, end: null, step: 1, perSheet: 16, cols: 4, width: 480,+    gutter: 2, subtitle: true, diff: 6, ocrPython: DEFAULT_OCR_PY,+    bottom: 0.80, ocrWidth: 960,+  };+  const rest = [];+  for (let i = 0; i < argv.length; i++) {+    const a = argv[i];+    const next = () => argv[++i];+    if (a === '--start') out.start = Number(next());+    else if (a === '--end') out.end = Number(next());+    else if (a === '--step') out.step = Math.max(0.2, Number(next()));+    else if (a === '--per-sheet') out.perSheet = Math.max(1, Number(next()));+    else if (a === '--cols') out.cols = Math.max(1, Number(next()));+    else if (a === '--width') out.width = Math.max(160, Number(next()));+    else if (a === '--diff') out.diff = Math.max(0, Number(next()));+    else if (a === '--bottom') out.bottom = Math.max(0.3, Math.min(0.95, Number(next())));+    else if (a === '--ocr-width') out.ocrWidth = Math.max(480, Number(next()));+    else if (a === '--ocr-python') out.ocrPython = next();+    else if (a === '--out') out.out = next();+    else if (a === '--ffmpeg') out.ffmpeg = next();+    else if (a === '--no-subtitle') out.subtitle = false;+    else rest.push(a);+  }+  out.input = rest[0];+  return out;+}++async function probeDuration(input, ffmpegPath) {+  const probe = await findFfprobe();+  if (probe) {+    const res = await run(probe, [+      '-v', 'error', '-show_entries', 'format=duration',+      '-of', 'default=noprint_wrappers=1:nokey=1', input,+    ], { timeoutMs: 30_000 });+    const n = Number(String(res.stderr || res.stdout || '').trim());+    if (Number.isFinite(n) && n > 0) return n;+  }+  const res = await run(ffmpegPath, ['-hide_banner', '-nostdin', '-i', input], { timeoutMs: 30_000 });+  const meta = parseFfmpegBanner(res.stderr || '', input);+  if (meta?.duration) return Number(meta.duration);+  throw new Error('没法确定时长：请显式传 --end <秒>');+}++function frameDiff(a, b) {+  if (!a || !b || a.data.length !== b.data.length) return 100;+  let sum = 0, n = 0;+  for (let i = 0; i < a.dat